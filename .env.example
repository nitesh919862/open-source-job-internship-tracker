# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/opentrack)
MONGODB_URI=""

# JWT Configuration (required in production)
JWT_SECRET="replace-with-a-strong-random-secret-key"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"

# Manual Admin Initialization (used by `npm run init-admin` — never commit real credentials)
# Automatic demo seeding is disabled when NODE_ENV="production".
# ADMIN_INIT_EMAIL="admin@yourdomain.com"
# ADMIN_INIT_PASSWORD=""
# ADMIN_INIT_NAME="Platform Administrator"

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
